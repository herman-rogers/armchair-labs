[Unit]
Description=Armchair Labs observation tables and campaign forecast refresh
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=3600
StartLimitBurst=3

[Service]
Type=oneshot
WorkingDirectory=%h/dev/armchair-labs
Environment=OMP_NUM_THREADS=4
Environment=OPENBLAS_NUM_THREADS=4
Environment=POLARS_MAX_THREADS=4
ExecStart=%h/dev/armchair-labs/.venv/bin/python -m engine.data.pipeline refresh
TimeoutStartSec=3600
Restart=on-failure
RestartSec=300

