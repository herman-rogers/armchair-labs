# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# ESPN private-league access needs two cookies from a logged-in browser session.
# In devtools: Application > Cookies > fantasy.espn.com.
#
# These grant FULL access to the league under your account. Treat them like a
# password: never commit them, never paste them into a bug report. They rarely
# expire, but they do expire — a sudden 401 usually means it's time to re-copy.
#
# Phase 1 does not read any of this. It's needed from Phase 2 (ESPN sync) onward.

ESPN_LEAGUE_ID=
ESPN_TEAM_ID=
ESPN_S2=
ESPN_SWID=

# Optional overrides.
# DATA_DIR=/path/to/data
# NFLVERSE_CACHE_DURATION=86400
