# Copy to .env, or just run `engine auth login` and let it fill this in.
#
# `engine auth login` opens Chrome, waits for you to sign in to ESPN normally, reads
# the resulting session cookies, discovers your league, and writes the four values
# below with mode 600. Nothing is typed into the login form on your behalf.
#
# ESPN_S2 and ESPN_SWID are session cookies that grant FULL access to your league.
# Treat them like a password: never commit them, never paste them into a bug report.
# They rarely expire, but they do — a sudden 401 means re-run `engine auth login`.
#
# On a homelab box without a browser, set these as environment variables instead;
# the process environment takes precedence over this file.

ESPN_LEAGUE_ID=
ESPN_TEAM_ID=
ESPN_S2=
ESPN_SWID=

# Optional overrides.
# DATA_DIR=/path/to/data
# NFLVERSE_CACHE_DURATION=86400
